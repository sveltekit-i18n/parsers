{
  "name": "@sveltekit-i18n/parser-curly",
  "version": "3.0.0-next.0",
  "description": "Curly Message Format parser for the sveltekit-i18n library.",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build && npm run typecheck",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "lint": "eslint --fix .",
    "prepare": "cd .. && simple-git-hooks parser-curly/.simple-git-hooks.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sveltekit-i18n/parsers.git",
    "directory": "parser-curly"
  },
  "keywords": [
    "parser",
    "curly",
    "curly-message",
    "i18n",
    "sveltekit-i18n"
  ],
  "author": "Jarda Svoboda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sveltekit-i18n/lib/issues"
  },
  "homepage": "https://github.com/sveltekit-i18n/parsers/tree/master/parser-curly#readme",
  "peerDependencies": {
    "@sveltekit-i18n/base": "^3.0.0-next.0"
  },
  "dependencies": {
    "@curly-message/parser": "^1.0.0-next.2"
  },
  "devDependencies": {
    "@curly-message/conformance": "^1.0.0-next.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltekit-i18n/base": "^3.0.0-next.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.11.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.0.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
